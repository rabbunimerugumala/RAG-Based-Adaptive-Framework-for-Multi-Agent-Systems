# Copy to .env and edit. Every variable is optional; the values shown are the defaults.
# No API keys are needed: all models run locally.

# dev  = lightweight development/testing mode (no downloads, NO language model - not for reporting results)
# real = local models (Ollama LLM + fastembed embeddings + NLI verifier)
ARAG_MODE=dev

# --- Local LLM served by Ollama ---
ARAG_OLLAMA_URL=http://127.0.0.1:11434
# Model and context come from ARAG_HARDWARE_PROFILE (32gb: the values below). Uncomment only to override the profile.
# ARAG_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# ARAG_OLLAMA_NUM_CTX=4096
# Uncomment to force CPU-only generation (0 GPU layers):
# ARAG_OLLAMA_NUM_GPU=0
ARAG_LLM_TIMEOUT_S=180

# --- Embeddings, verifier, reranker ---
ARAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ARAG_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
# none | cross-encoder   (cross-encoder downloads ~80 MB on first use)
ARAG_RERANKER=none

# --- Ingestion and retrieval ---
ARAG_MAX_UPLOAD_MB=20
ARAG_CHUNK_SIZE=900
ARAG_CHUNK_OVERLAP=150
ARAG_TOP_K=5
ARAG_CANDIDATE_K=20

# --- Confidence agent (experimental parameters) ---
ARAG_W_RELEVANCE=0.25
ARAG_W_COVERAGE=0.25
ARAG_W_VERIFICATION=0.35
ARAG_W_CONSISTENCY=0.15
ARAG_ACCEPT_THRESHOLD=0.65
ARAG_ABSTAIN_THRESHOLD=0.40
ARAG_MAX_RETRIES=2

# --- Question routing (Planner) and hardware profile ---
# true (default): simple questions get a lightweight round + at most 1 escalation round; false: evaluated v2 behaviour
# Routing is ON by default (code default true). Uncomment and set to false to run the evaluated v2 without routing.
# ARAG_QUESTION_ROUTING=true
ARAG_SIMPLE_ROUTE_RETRIES=1
# 8gb | 16gb | 32gb - fills defaults you did not set yourself (see docs/setup_guide.md)
ARAG_HARDWARE_PROFILE=32gb

# --- API ---
ARAG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
